{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sonicscout2-share",
  "main": "src/index.js",
  "compatibility_date": "2026-09-23",
  "account_id": "9c5f81e73d237bab60bdb0bc2085cd56",
  "r2_buckets": [
    {
      "binding": "SHARE_BUCKET",
      "bucket_name": "sonicscout2-share"
    }
  ],
  "ratelimits": [
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "41004",
      "simple": { "limit": 12, "period": 60 }
    },
    {
      "name": "UPLOAD_RATE_LIMITER",
      "namespace_id": "42004",
      "simple": { "limit": 20, "period": 60 }
    }
  ]
}
