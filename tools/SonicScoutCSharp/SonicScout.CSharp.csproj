<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>SonicScout</AssemblyName>
    <RootNamespace>SonicScout</RootNamespace>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <None Include="Install-SonicScout.bat" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
    <None Include="download_dependencies.ps1" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
    <None Include="..\..\powershell\Install-SonicScout2.0.ps1" Link="Install-SonicScout2.0.ps1" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
    <None Include="..\..\library\**\*" Link="library\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
    <None Include="..\..\hrir\**\*" Link="hrir\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <Compile Remove="ScoutPass\**" />
    <EmbeddedResource Remove="ScoutPass\**" />
    <None Remove="ScoutPass\**" />
    <None Include="logo.png" Condition="Exists('logo.png')" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
    <None Include="setup_audio_stack.ps1" Condition="Exists('setup_audio_stack.ps1')" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
    <None Include="run_audio_stack_setup.bat" Condition="Exists('run_audio_stack_setup.bat')" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
    <None Remove="profiles\**" />
    <Content Remove="profiles\**" />
    <EmbeddedResource Remove="profiles\**" />
    <None Include="targets\*.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />

    <!-- setup_audio_stack.ps1 resolves its third-party installers from
         <app base>\installers (setup_audio_stack.ps1:17). Without these copies the
         wizard reports "Place the installer in ...\installers" on every published
         build, because the folder only ever existed in the source tree. -->
    <None Include="installers\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
    <!-- Download-Installer's last-resort fallback shells to this .bat; setup_audio_stack.ps1:263
         returns $false without it. -->
    <None Include="auto_setup_dependencies.bat" Condition="Exists('auto_setup_dependencies.bat')" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />

    <!-- A published first-user package must be able to complete the same APO/library
         configuration as a source checkout. Keep the main installer and tune library
         beside the app so setup_audio_stack.ps1 can finish even when no GitHub Release
         asset is available. -->
    <None Include="..\..\powershell\Install-SonicScout2.0.ps1"
          Link="Install-SonicScout2.0.ps1"
          Condition="Exists('..\..\powershell\Install-SonicScout2.0.ps1')"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="Always" />
    <None Include="..\..\library\**\*"
          Link="library\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="Always" />
  </ItemGroup>

  <!-- Builds ScoutPass with the app so setup never reports "SonicPass is not built".
       ResolveSonicPassExecutablePath (MainWindow.xaml.cs:1674) looks for
       SonicScout.ScoutPass.exe beside the app first. The Compile/EmbeddedResource/None
       Removes above keep ScoutPass's sources out of THIS assembly, so the ProjectReference
       is the only thing compiling them - without it the two would collide. -->
  <ItemGroup>
    <ProjectReference Include="ScoutPass\SonicScout.ScoutPass.csproj" />
  </ItemGroup>
</Project>
