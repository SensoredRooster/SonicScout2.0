<Window x:Class="SonicScout.PostInstallVerifyDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="620" Height="640"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent">
    <Border Margin="2" Background="{DynamicResource PopupBrush}" BorderBrush="{DynamicResource PopupBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <StackPanel>
                    <TextBlock Text="VERIFY YOUR SETTINGS" Foreground="{DynamicResource PopupTextBrush}" FontSize="18" FontWeight="Bold" />
                    <TextBlock Text="These settings can't be checked automatically. Confirm each one in Windows, then mark it done."
                               Foreground="{DynamicResource PopupTextBrush}" Opacity="0.9" FontSize="12" Margin="0,5,0,0" TextWrapping="Wrap" />
                </StackPanel>
                <Button Content="×" Width="30" Height="28" Padding="0" FontSize="16" HorizontalAlignment="Right" Click="CloseButton_Click" ToolTip="Close" />
            </Grid>

            <Button x:Name="OpenSoundSettingsButton"
                    Grid.Row="1"
                    Width="260"
                    MinHeight="52"
                    Height="Auto"
                    HorizontalAlignment="Left"
                    Margin="0,14,0,10"
                    Padding="10,8"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Click="OpenSoundSettingsButton_Click">
                <TextBlock Text="OPEN WINDOWS SOUND SETTINGS"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           FontWeight="Bold"
                           FontSize="11" />
            </Button>

            <Border Grid.Row="2" Background="{DynamicResource PopupBrush}" BorderBrush="{DynamicResource PopupBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="6">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="ChecklistItemsControl" />
                </ScrollViewer>
            </Border>

            <Grid Grid.Row="3" Margin="0,12,0,0">
                <TextBlock x:Name="SummaryText" Foreground="{DynamicResource PopupTextBrush}" Opacity="0.85" FontSize="12" VerticalAlignment="Center" />
                <Button x:Name="DoneButton" Content="DONE" Width="150" Height="38" FontSize="12" HorizontalAlignment="Right" Click="DoneButton_Click" />
            </Grid>
        </Grid>
    </Border>
</Window>
