<Window x:Class="SonicScout.ConfirmProfileDeleteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="420" Height="220"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent">
    <Border Margin="2" Background="{DynamicResource PopupBrush}" BorderBrush="{DynamicResource PopupBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <TextBlock Text="DELETE PROFILE" Foreground="{DynamicResource PopupTextBrush}" FontSize="16" FontWeight="Bold" />
                <Button Content="×" Width="28" Height="26" Padding="0" HorizontalAlignment="Right" Click="Cancel_Click" ToolTip="Cancel" />
            </Grid>
            <TextBlock x:Name="MessageText" Grid.Row="1" Foreground="{DynamicResource PopupTextBrush}" FontSize="14" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,14,0,14" />
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="CANCEL" Width="104" Height="40" FontSize="13" Foreground="{DynamicResource PopupTextBrush}" Background="{DynamicResource PopupBrush}" Margin="0,0,10,0" Click="Cancel_Click" />
                <Button Content="DELETE" Width="104" Height="40" FontSize="13" Foreground="{DynamicResource PopupHoverTextBrush}" Background="{DynamicResource ErrorBrush}" Click="Delete_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
