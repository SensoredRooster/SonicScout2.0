<Window x:Class="SonicScout.HeadphoneProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="700" Height="560"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="True"
        Background="Transparent">
    <Window.Resources>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="{DynamicResource PopupBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PopupTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="4" />
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource PopupTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource PopupBrush}" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="0,0,0,3" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource PopupHoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource PopupHoverTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{DynamicResource PopupHoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource PopupHoverTextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border Margin="2" Background="{DynamicResource PopupBrush}" BorderBrush="{DynamicResource PopupBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="18">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <StackPanel>
                    <TextBlock Text="SELECT HEADPHONE / IEM PROFILE" Foreground="{DynamicResource PopupTextBrush}" FontSize="16" FontWeight="Bold" />
                    <TextBlock x:Name="StatusText" Text="Loading AutoEq catalog..." Foreground="{DynamicResource PopupTextBrush}" Opacity="0.82" FontSize="11" Margin="0,5,0,0" />
                </StackPanel>
                <Button Content="×" Width="28" Height="26" Padding="0" HorizontalAlignment="Right" Click="Cancel_Click" ToolTip="Close" />
            </Grid>
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,16,0,10">
                <ComboBox x:Name="CategoryComboBox" Width="130" Height="32" FontSize="11" SelectedIndex="0" SelectionChanged="CategoryComboBox_SelectionChanged">
                    <ComboBoxItem Content="All" />
                    <ComboBoxItem Content="Headphones" />
                    <ComboBoxItem Content="IEMs" />
                </ComboBox>
                <TextBox x:Name="SearchBox"
                         Width="360"
                         Height="36"
                         FontSize="14"
                         Padding="8,4"
                         Margin="10,0,0,0"
                         Foreground="{DynamicResource PopupTextBrush}"
                         Background="{DynamicResource BackgroundBrush}"
                         BorderBrush="{DynamicResource AccentBrush}"
                         CaretBrush="{DynamicResource PopupTextBrush}"
                         VerticalContentAlignment="Center"
                         ToolTip="Type a headset or IEM model to filter"
                         TextChanged="SearchBox_TextChanged" />
                <Button Content="REFRESH" Width="88" Height="32" FontSize="11" Margin="10,0,0,0" Padding="5,2" Click="Refresh_Click" />
            </StackPanel>
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="GAME TARGET" Foreground="{DynamicResource PopupTextBrush}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0" />
                <ComboBox x:Name="TargetCurveComboBox" Width="300" Height="32" FontSize="11" SelectedIndex="0" />
                <TextBlock Text="Choose the game curve you want to pair with this headset. Sonic Scout saves the local target beside the headphone EQ for the tune workflow." Foreground="{DynamicResource PopupTextBrush}" Opacity="0.85" FontSize="10" VerticalAlignment="Center" Margin="10,0,0,0" TextWrapping="Wrap" />
            </StackPanel>
            <ListBox x:Name="ProfileListBox" Grid.Row="3" MouseDoubleClick="ProfileListBox_MouseDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" Foreground="{DynamicResource PopupTextBrush}" FontSize="13" FontWeight="Bold" TextAlignment="Center" />
                            <TextBlock Text="{Binding Category}" Foreground="{DynamicResource PopupTextBrush}" Opacity="0.82" FontSize="11" TextAlignment="Center" Margin="0,3,0,0" />
                            <TextBlock Text="{Binding Source}" Foreground="{DynamicResource PopupTextBrush}" Opacity="0.72" FontSize="9" TextAlignment="Center" Margin="0,2,0,0" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button Content="CANCEL" Width="104" Height="40" FontSize="12" Margin="0,0,10,0" Click="Cancel_Click" />
                <Button Content="USE PROFILE" Width="140" Height="40" FontSize="12" Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource OnPrimaryBrush}" Click="UseProfile_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
